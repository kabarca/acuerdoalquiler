// Esquema de datos del sistema de cobro de renta.
// Ver CLAUDE.md para el flujo funcional completo.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum TipoCuentaBancaria {
  NACIONAL
  INTERNACIONAL
}

// Un arrendador = una cuenta (login vía Supabase Auth).
model Arrendador {
  id                 String              @id @default(uuid())
  supabaseUserId     String              @unique
  nombre             String
  email              String              @unique
  telefono           String?
  // Datos bancarios que se le muestran al inquilino cuando paga por
  // transferencia (ver TenantOnboarding / PaymentTransfer del diseño).
  // Si es INTERNACIONAL, además se piden los datos de wire transfer
  // (swiftBic, direcciones, país) — cuentaIban se reusa como "cuenta o IBAN".
  tipoCuentaBancaria TipoCuentaBancaria  @default(NACIONAL)
  banco              String?
  cuentaIban         String?
  titularCuenta      String?
  swiftBic           String?
  paisBanco          String?
  direccionBanco     String?
  direccionTitular   String?
  numeroRuta         String? // routing/ABA — solo aplica a algunos bancos (p. ej. EE. UU.)
  // true solo para las cuentas del equipo de Rentia — les da acceso a
  // /admin (ver lib/auth.ts). Nunca se ofrece en el registro público.
  esAdmin            Boolean             @default(false)
  creadoEn           DateTime            @default(now())

  propiedades Propiedad[]

  @@map("arrendadores")
}

enum TipoPropiedad {
  APARTAMENTO
  CASA
  LOCAL_COMERCIAL
}

model Propiedad {
  id           String        @id @default(uuid())
  arrendadorId String
  arrendador   Arrendador    @relation(fields: [arrendadorId], references: [id], onDelete: Cascade)
  direccion    String
  tipo         TipoPropiedad @default(APARTAMENTO)
  canton       String?
  creadoEn     DateTime      @default(now())

  inquilinos Inquilino[]

  @@map("propiedades")
}

enum MetodoPago {
  TRANSFERENCIA
  DEBITO
  CREDITO
}

// El inquilino NO tiene cuenta — solo recibe correos con el link de pago,
// salvo cuando el arrendador lo invita a configurar su propio método de
// pago (ver InviteTenant / TenantOnboarding), momento en el que puede
// autorizar compartir su historial de pago con otros arrendadores.
model Inquilino {
  id                  String      @id @default(uuid())
  propiedadId         String
  propiedad           Propiedad   @relation(fields: [propiedadId], references: [id], onDelete: Cascade)
  nombre              String
  email               String
  telefono            String?
  cedula              String? // identifica al inquilino entre arrendadores para la búsqueda de reputación
  montoRenta          Decimal     @db.Decimal(10, 2)
  // Calendario de facturación que fija el arrendador (todos 1-28):
  // - diaGeneracion: día del mes en que el sistema crea la factura.
  // - diaEnvio: día del mes en que se le manda por correo al inquilino
  //   (nunca antes de diaGeneracion).
  // - diaCobro: fecha máxima de pago. Si es menor que diaEnvio, cae en el
  //   mes siguiente (ver calcularFechaVencimiento en lib/facturacion.ts).
  diaGeneracion       Int         @default(1)
  diaEnvio            Int         @default(1)
  diaCobro            Int
  fechaInicioContrato DateTime?
  fechaFinContrato    DateTime? // se completa al quitar al inquilino, o null = sigue vigente
  metodoPagoPreferido MetodoPago?
  compartirHistorial  Boolean     @default(false) // opt-in explícito, ver TenantSearch
  activo              Boolean     @default(true) // false = ya no es inquilino actual (se conserva para el historial)
  motivoSalida        String? // ver RemoveTenantFeedback
  notaSalida          String?
  invitacionEnviadaEn DateTime?
  creadoEn            DateTime    @default(now())

  facturas Factura[]
  disputas Disputa[]
  verificacionIdentidad VerificacionIdentidad?

  @@map("inquilinos")
}

enum EstadoVerificacion {
  PENDIENTE
  COMPLETADA
  EXPIRADA
}

// Verificación de identidad del inquilino: el arrendador envía un link/QR
// por correo, el inquilino lo abre en su celular y ahí mismo toma la foto
// de su cédula y una selfie (sin descargar nada). El match de rostros se
// calcula EN EL NAVEGADOR del inquilino con face-api.js (evita depender de
// un backend con GPU/Python) y el resultado se manda junto con las fotos;
// el OCR del texto de la cédula sí corre en el servidor con tesseract.js.
// Nota: como el match lo calcula el cliente, es una señal de apoyo para el
// arrendador, no una prueba criminalística — por eso también se guardan
// ambas fotos para que el arrendador las compare a simple vista.
model VerificacionIdentidad {
  id                  String              @id @default(uuid())
  inquilinoId         String              @unique
  inquilino           Inquilino           @relation(fields: [inquilinoId], references: [id], onDelete: Cascade)
  token               String              @unique
  tokenExpiraEn       DateTime
  estado              EstadoVerificacion  @default(PENDIENTE)
  cedulaFotoBytes     Bytes?
  cedulaFotoTipo      String?
  selfieFotoBytes     Bytes?
  selfieFotoTipo      String?
  textoExtraidoCedula String?
  rostrosCoinciden    Boolean?
  distanciaRostros    Float?
  enviadoEn           DateTime? // cuándo se creó el enlace
  correoEnviadoEn     DateTime? // solo se llena si el correo de verdad salió
  errorEnvio          String? // por qué no salió (p. ej. correo sin configurar)
  completadoEn        DateTime?
  creadoEn            DateTime            @default(now())

  @@map("verificaciones_identidad")
}

enum EstadoFactura {
  PENDIENTE
  PAGADA
  ATRASADA
  EN_REVISION // comprobante de transferencia subido, esperando que el arrendador lo confirme
}

model Factura {
  id                       String        @id @default(uuid())
  inquilinoId              String
  inquilino                Inquilino     @relation(fields: [inquilinoId], references: [id], onDelete: Cascade)
  periodo                  String // formato "YYYY-MM"
  monto                    Decimal       @db.Decimal(10, 2)
  fechaVencimiento         DateTime
  estado                   EstadoFactura @default(PENDIENTE)
  metodoPago               MetodoPago?
  onvopayPaymentId         String? // referencia del cobro en Onvopay
  onvopayPaymentLinkUrl    String?
  // Comprobante de transferencia — se guarda en la propia base de datos
  // (no hay bucket de almacenamiento configurado todavía).
  comprobanteBytes         Bytes?
  comprobanteTipo          String?
  comprobanteNombre        String?
  comprobanteSubidoEn      DateTime?
  // Envío automático de la factura por correo (ver lib/facturacion.ts). Se
  // llena solo cuando Resend confirma el envío; si falla queda null y
  // errorEnvio guarda el motivo — el cron lo reintenta al día siguiente.
  facturaEnviadaEn         DateTime?
  errorEnvio               String?
  recordatorioEnviadoEn    DateTime?
  avisoArrendadorEnviadoEn DateTime?
  pagadoEn                 DateTime?
  creadoEn                 DateTime      @default(now())

  disputa Disputa?

  @@unique([inquilinoId, periodo])
  @@map("facturas")
}

enum EstadoDisputa {
  ABIERTA
  RESUELTA
}

enum ResolucionDisputa {
  PRORROGA
  MOROSO
}

// Se abre cuando una factura queda muy atrasada (ver DisputeNotification).
// El arrendador la resuelve otorgando una prórroga o marcando al inquilino
// como moroso (ver GrantExtension / MarkDelinquent / DisputeResolved).
model Disputa {
  id                  String             @id @default(uuid())
  facturaId            String             @unique
  factura              Factura            @relation(fields: [facturaId], references: [id], onDelete: Cascade)
  inquilinoId          String
  inquilino            Inquilino          @relation(fields: [inquilinoId], references: [id], onDelete: Cascade)
  estado               EstadoDisputa      @default(ABIERTA)
  motivoApertura       String
  fechaApertura        DateTime           @default(now())
  respuestaInquilino   String?
  fechaRespuesta       DateTime?
  resolucion           ResolucionDisputa?
  motivoResolucion     String?
  nuevaFechaVencimiento DateTime?
  fechaResolucion      DateTime?

  @@map("disputas")
}
